  <script>
    // Configuration
    const API_KEY = 'AIzaSyCHtRnM7EmexV_oL70RPTovKOAu9QgVsPI';
    const MODEL_ID = 'gemini-3.0-pro'; // Updated to point to Gemini 3.0 API endpoint
    const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_ID}:generateContent?key=${API_KEY}`;

    const SYSTEM_PROMPT = `You are SmartCal AI. Return ONLY a raw JSON object for the food described. 
    Search the web for real nutritional data before answering.
    JSON Schema:
    {
      "food_name": "string",
      "serving_description": "string",
      "confidence": "high"|"medium"|"low",
      "calories": number,
      "calorie_range_low": number,
      "calorie_range_high": number,
      "protein_g": number,
      "carbs_g": number,
      "fat_g": number,
      "fiber_g": number,
      "sugar_g": number,
      "sodium_mg": number,
      "health_score": number,
      "insight": "2-3 sentences based on web research",
      "tags": ["array"],
      "image_query": "search term"
    }`;

    async function analyzeText() {
      const input = document.getElementById('food-input').value;
      if(!input) return;
      startUI();
      try {
        const data = await callGemini(input);
        render(data);
      } catch(e) {
        document.getElementById('error-text').innerText = "Error analyzing food.";
        document.getElementById('error-text').style.display = "block";
      } finally {
        stopUI();
      }
    }

    async function callGemini(text, imgData = null) {
      const parts = [{ text: text }];
      if(imgData) parts.push({ inline_data: { mime_type: imgData.type, data: imgData.b64 } });

      const response = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts }],
          system_instruction: { parts: [{ text: SYSTEM_PROMPT }] },
          tools: [{ google_search: {} }], // ENABLE GOOGLE SEARCH GROUNDING
          generationConfig: { response_mime_type: "application/json", temperature: 0.2 }
        })
      });
      const resJson = await response.json();
      return JSON.parse(resJson.candidates[0].content.parts[0].text);
    }

    function render(d) {
      document.getElementById('result-section').style.display = 'block';
      document.getElementById('food-name').innerText = d.food_name;
      document.getElementById('food-serving').innerText = d.serving_description;
      document.getElementById('cal-num').innerText = d.calories;
      document.getElementById('cal-range').innerText = `${d.calorie_range_low} - ${d.calorie_range_high} kcal`;
      document.getElementById('insight-text').innerText = d.insight;
      
      // Update Macros
      const macros = ['Protein', 'Carbs', 'Fat'];
      const vals = [d.protein_g, d.carbs_g, d.fat_g];
      let html = '';
      macros.forEach((m, i) => {
        html += `<div class="macro-row"><span>${m}</span><div class="macro-track"><div class="macro-fill" style="width:${Math.min(vals[i]*2, 100)}%; background:#4285f4"></div></div><span>${vals[i]}g</span></div>`;
      });
      document.getElementById('macro-container').innerHTML = html;

      // Update Image
      document.getElementById('food-img').src = `https://source.unsplash.com/800x400/?${encodeURIComponent(d.image_query)}`;
    }

    function startUI() {
      document.getElementById('stream-status').classList.add('active');
      document.getElementById('stream-fill').style.width = '70%';
    }
    function stopUI() {
      document.getElementById('stream-fill').style.width = '100%';
      setTimeout(() => document.getElementById('stream-status').classList.remove('active'), 500);
    }
    function switchTab(t) {
      document.getElementById('text-panel').style.display = t === 'text' ? 'block' : 'none';
      document.getElementById('scan-panel').style.display = t === 'scan' ? 'block' : 'none';
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-'+t).classList.add('active');
    }
  </script>
</body>
