<script>
  /* ─── RAIN ANIMATION ─────────────────────── */
  const canvas = document.getElementById('rain');
  const ctx    = canvas.getContext('2d');
  let drops    = [];

  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    initDrops();
  }

  function initDrops() {
    drops = [];
    const n = Math.floor(canvas.width / 12);
    for (let i = 0; i < n; i++) {
      drops.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        len: 14 + Math.random() * 24,
        speed: 1.8 + Math.random() * 2.2,
        opacity: 0.25 + Math.random() * 0.5,
        width: 0.6 + Math.random() * 0.8
      });
    }
  }

  function drawRain() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drops.forEach(d => {
      ctx.beginPath();
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x - d.len * 0.18, d.y + d.len);
      ctx.strokeStyle = `rgba(140,130,180,${d.opacity})`;
      ctx.lineWidth   = d.width;
      ctx.stroke();
      d.y += d.speed;
      if (d.y > canvas.height) {
        d.y   = -d.len;
        d.x   = Math.random() * canvas.width;
      }
    });
    requestAnimationFrame(drawRain);
  }

  window.addEventListener('resize', resize);
  resize();
  drawRain();

  /* ─── DRAG-SCROLL SHELF ──────────────────── */
  const shelf = document.getElementById('shelf');
  let isDown = false, startX, scrollLeft;

  shelf.addEventListener('mousedown', e => {
    isDown    = true;
    startX    = e.pageX - shelf.offsetLeft;
    scrollLeft = shelf.scrollLeft;
  });

  shelf.addEventListener('mouseleave', () => isDown = false);
  shelf.addEventListener('mouseup',    () => isDown = false);
  shelf.addEventListener('mousemove', e => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - shelf.offsetLeft;
    shelf.scrollLeft = scrollLeft - (x - startX) * 1.4;
  });

  /* ─── MOBILE NAV ─────────────────────────── */
  function toggleNav() {
    document.getElementById('main-nav').classList.toggle('open');
  }

  /* ─── SCROLL REVEAL ──────────────────────── */
  const cards = document.querySelectorAll('.card');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  cards.forEach(c => {
    c.style.opacity = '0';
    c.style.transform = 'translateY(30px)';
    c.style.transition = 'opacity .5s ease, transform .5s ease, box-shadow .18s';
    io.observe(c);
  });
</script>

</body>
</html>
